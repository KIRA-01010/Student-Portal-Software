# Copy to `.env` and adjust. Never commit the real `.env`.

# --- General ---
APP_NAME="Student Portal"
# true  = local development (autoreload, /docs, migrations run on startup).
# false = production. The app then REFUSES TO START unless SECRET_KEY is a
#         real random value, and it never changes the schema by itself.
DEBUG=true

# --- Security ---
# Required (32+ chars, not this placeholder) whenever DEBUG=false.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY="change-me-to-a-long-random-string"
SESSION_COOKIE_NAME="student_portal_session"
SESSION_MAX_AGE=604800          # 7 days, in seconds
SESSION_HTTPS_ONLY=false        # set true once you serve over HTTPS

# Brute-force protection: this many failed sign-ins for one account from one
# address within the window locks that visitor out until the window slides past.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900       # 15 minutes

# --- Database ---
# SQLite for development; swap for Postgres in production, e.g.
# DATABASE_URL="postgresql+psycopg://user:pass@localhost:5432/student_portal"
DATABASE_URL="sqlite:///./student_portal.db"
